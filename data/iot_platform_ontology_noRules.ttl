@prefix : <http://www.semanticweb.org/owl/owlapi/turtle#> .
@prefix bop: <https://w3id.org/bop#> .
@prefix bot: <https://w3id.org/bot#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix iotpo: <https://fhnw.ch/iotpo#> .
@base <http://www.semanticweb.org/owl/owlapi/turtle#> .

<https://fhnw.ch/iotpo#> rdf:type owl:Ontology ;
                          owl:imports sosa: ,
                                      <https://w3id.org/bop> ,
                                      <https://w3id.org/bot> .

#################################################################
#    Annotation properties
#################################################################

###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  https://fhnw.ch/iotpo#dispatchedBy
iotpo:dispatchedBy rdf:type owl:ObjectProperty ;
                   rdfs:domain iotpo:Message ;
                   rdfs:range iotpo:Device .


###  https://fhnw.ch/iotpo#hasObservation
iotpo:hasObservation rdf:type owl:ObjectProperty ;
                     owl:inverseOf iotpo:isObservationContainedIn ;
                     rdfs:domain iotpo:Message ;
                     rdfs:range sosa:Observation .


###  https://fhnw.ch/iotpo#hasSubDevice
iotpo:hasSubDevice rdf:type owl:ObjectProperty ;
                   rdfs:domain iotpo:Device ;
                   rdfs:range iotpo:Device .


###  https://fhnw.ch/iotpo#isAggregatedSensor
iotpo:isAggregatedSensor rdf:type owl:DatatypeProperty ;
                         rdfs:domain bop:Sensor ;
                         rdfs:range xsd:boolean .


###  https://fhnw.ch/iotpo#isContainedInZone
iotpo:isContainedInZone rdf:type owl:ObjectProperty ;
                        rdfs:domain iotpo:Device ;
                        rdfs:range bot:Zone .


###  https://fhnw.ch/iotpo#isObservationContainedIn
iotpo:isObservationContainedIn rdf:type owl:ObjectProperty ,
                                        owl:FunctionalProperty ;
                               rdfs:domain sosa:Observation ;
                               rdfs:range iotpo:Message .


###  https://fhnw.ch/iotpo#isRepresentedBy
iotpo:isRepresentedBy rdf:type owl:ObjectProperty ;
                      owl:inverseOf iotpo:represents ;
                      rdfs:domain sosa:Sensor ;
                      rdfs:range iotpo:Device .


###  https://fhnw.ch/iotpo#receivedVia
iotpo:receivedVia rdf:type owl:ObjectProperty ;
                  rdfs:domain iotpo:Message ;
                  rdfs:range iotpo:Channel .


###  https://fhnw.ch/iotpo#represents
iotpo:represents rdf:type owl:ObjectProperty ;
                 rdfs:domain iotpo:Device ;
                 rdfs:range sosa:Sensor .


#################################################################
#    Data properties
#################################################################

###  https://fhnw.ch/iotpo#hasContent
iotpo:hasContent rdf:type owl:DatatypeProperty ;
                 rdfs:domain iotpo:Message ;
                 rdfs:range xsd:string .


###  https://fhnw.ch/iotpo#hasFormat
iotpo:hasFormat rdf:type owl:DatatypeProperty ;
                rdfs:domain iotpo:Message ;
                rdfs:range xsd:string .


###  https://fhnw.ch/iotpo#hasProtocol
iotpo:hasProtocol rdf:type owl:DatatypeProperty ;
                  rdfs:domain iotpo:Channel ;
                  rdfs:range xsd:string .


###  https://fhnw.ch/iotpo#hasType
iotpo:hasType rdf:type owl:DatatypeProperty ;
              rdfs:domain iotpo:Message ;
              rdfs:range xsd:string .


###  https://fhnw.ch/iotpo#requiresAuthentication
iotpo:requiresAuthentication rdf:type owl:DatatypeProperty ;
                             rdfs:domain iotpo:Channel ;
                             rdfs:range xsd:boolean .


###  https://fhnw.ch/iotpo#hasId
iotpo:hasId rdf:type owl:DatatypeProperty ;
            rdfs:domain [ rdf:type owl:Class ;
                          owl:unionOf ( iotpo:Device bot:Zone )
                        ] ;
            rdfs:range xsd:string .


#################################################################
#    Classes
#################################################################

###  http://www.w3.org/ns/sosa/Observation
sosa:Observation rdfs:subClassOf [ rdf:type owl:Restriction ;
                                   owl:onProperty iotpo:isObservationContainedIn ;
                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                   owl:onClass iotpo:Message
                                 ] .


###  https://fhnw.ch/iotpo#Channel
iotpo:Channel rdf:type owl:Class .


###  https://fhnw.ch/iotpo#Device
iotpo:Device rdf:type owl:Class .


###  https://fhnw.ch/iotpo#Message
iotpo:Message rdf:type owl:Class ;
              rdfs:subClassOf [ rdf:type owl:Restriction ;
                                owl:onProperty iotpo:hasObservation ;
                                owl:someValuesFrom sosa:Observation
                              ] .


###  https://w3id.org/bop#Actuator
bop:Actuator rdf:type owl:Class .


###  https://w3id.org/bop#Sensor
bop:Sensor rdf:type owl:Class .